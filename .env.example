# RouteRescue AI - Environment Configuration (Demo / Development)

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_PATH=data/routerescue.db

# API & Backend
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
STREAMLIT_PORT=8501

# Fetch.ai uAgents Configuration
BUREAU_PORT=8080
BUREAU_ENDPOINT=http://127.0.0.1:8080/submit

# Agentverse Integration (Optional for local testing, required for Agentverse Explorer/Mailbox)
AGENTVERSE_API_KEY=your_agentverse_api_key_here
AGENTVERSE_MAILBOX=false
AGENTVERSE_URL=https://agentverse.ai

# ASI:One Conversational LLM Integration (Optional: fallback NLP parser used if not configured)
ASI1_API_KEY=your_asi1_api_key_here
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1-mini

# Timezone
TIMEZONE=Asia/Kolkata
