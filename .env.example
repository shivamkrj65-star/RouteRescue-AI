# RouteRescue AI - Environment Configuration (Demo / Development)

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_PATH=data/routerescue.db

# API & Backend
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
STREAMLIT_PORT=8501

# Fetch.ai uAgents Configuration (for future Agent phases)
BUREAU_PORT=8080
BUREAU_ENDPOINT=http://127.0.0.1:8080/submit
AGENTVERSE_API_KEY=your_agentverse_api_key_here

# Timezone
TIMEZONE=Asia/Kolkata
